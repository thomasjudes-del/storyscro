  "evidence": [
    {
      "id": "ev-thesis",
      "type": "claim",
      "status": "VERIFIED",
      "text": "The paper proposes the Transformer, a network architecture based solely on attention mechanisms, dispensing with recurrence and convolutions entirely.",
      "source_refs": [
        {
          "file": "attention.pdf",
          "page": 1,
          "element_id": "p1-b13"
        }
      ]
    },
    {
      "id": "ev-parallel",
      "type": "claim",
      "status": "VERIFIED",
      "text": "The Transformer allows significantly more parallelization and can reach state-of-the-art translation quality after training for as little as twelve hours on eight P100 GPUs.",
      "source_refs": [
        {
          "file": "attention.pdf",
          "page": 2,
          "element_id": "p2-b5"
        }
      ]
    },
    {
      "id": "ev-encoder",
      "type": "claim",
      "status": "VERIFIED",
      "text": "The encoder is a stack of six identical layers; each has multi-head self-attention and a position-wise feed-forward network, with residual connections and layer normalization.",
      "source_refs": [
        {
          "file": "attention.pdf",
          "page": 3,
          "element_id": "p3-b5"
        }
      ]
    },
    {
      "id": "ev-decoder",
      "type": "claim",
      "status": "VERIFIED",
      "text": "The decoder is also a stack of six layers and adds multi-head attention over encoder outputs; masking prevents positions from attending to subsequent positions.",
      "source_refs": [
        {
          "file": "attention.pdf",
          "page": 3,
          "element_id": "p3-b6"
        }
      ]
    },
    {
      "id": "ev-complexity",
      "type": "claim",
      "status": "VERIFIED",
      "text": "A self-attention layer connects all positions with a constant number of sequentially executed operations, whereas a recurrent layer requires O(n) sequential operations.",
      "source_refs": [
        {
          "file": "attention.pdf",
          "page": 6,
          "element_id": "p6-b14"
        }
      ]
    },
    {
      "id": "ev-results",
      "type": "claim",
      "status": "VERIFIED",
      "text": "The big Transformer reports 28.4 BLEU on WMT 2014 English-to-German and 41.8 BLEU on English-to-French; the big model trained for 3.5 days on eight P100 GPUs.",
      "source_refs": [
        {
          "file": "attention.pdf",
          "page": 1,
          "element_id": "p1-b13"
        }
      ]
    }
  ],

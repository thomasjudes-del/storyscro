      "scenes": [
        {
          "id": "four-actions",
          "nav_label": "4 actions",
          "primitive": "scrollmation",
          "semantic_role": "ordered_method",
          "message": "The report sets out four cross-government moves to make adaptation executable.",
          "title": "Four moves from fragmented planning to delivery.",
          "data": {
            "steps": [
              {
                "n": "01",

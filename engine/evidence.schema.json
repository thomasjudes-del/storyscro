{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyscro.dev/schema/evidence.schema.json",
  "title": "StoryScro PDF Evidence Package",
  "type": "object",
  "required": ["version", "kind", "document", "style_profile", "pages", "elements"],
  "properties": {
    "version": {"type": "string"},
    "kind": {"const": "storyscro_evidence_package"},
    "document": {
      "type": "object",
      "required": ["source_file", "sha256", "page_count", "language"],
      "properties": {
        "source_file": {"type": "string"},
        "source_path": {"type": "string"},
        "sha256": {"type": "string"},
        "page_count": {"type": "integer", "minimum": 1},
        "metadata": {"type": "object"},
        "language": {"type": "string"},
        "text_characters": {"type": "integer"},
        "ocr_pages": {"type": "array", "items": {"type": "integer"}},
        "ocr_required_pages": {"type": "array", "items": {"type": "integer"}}
      },
      "additionalProperties": true
    },
    "style_profile": {"type": "object"},
    "repeated_margin_elements": {"type": "array", "items": {"type": "object"}},
    "title_candidates": {"type": "array", "items": {"type": "object"}},
    "sections": {"type": "array", "items": {"type": "object"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["image"]},
          "sha256": {"type": "string"},
          "dhash": {"type": ["string", "null"]},
          "width": {"type": ["integer", "null"]},
          "height": {"type": ["integer", "null"]},
          "file": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "statistics": {"type": "object"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "width", "height", "blocks", "derived"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "width": {"type": "number"},
          "height": {"type": "number"},
          "rotation": {"type": "integer"},
          "text_length": {"type": "integer"},
          "ocr_used": {"type": "boolean"},
          "image_area_ratio": {"type": "number"},
          "drawing_count": {"type": "integer"},
          "blocks": {"type": "array", "items": {"$ref": "#/$defs/textBlock"}},
          "derived": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    },
    "elements": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "span": {
      "type": "object",
      "required": ["text", "bbox", "size"],
      "properties": {
        "text": {"type": "string"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "font": {"type": ["string", "null"]},
        "size": {"type": "number"},
        "flags": {"type": "integer"},
        "bold": {"type": "boolean"},
        "color": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "textBlock": {
      "type": "object",
      "required": ["id", "type", "page", "bbox", "text", "semantic_type"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "text_block"},
        "page": {"type": "integer"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text": {"type": "string"},
        "semantic_type": {
          "enum": ["heading_1", "heading_2", "heading_3", "paragraph", "list_item", "quote_candidate", "caption", "label", "header", "footer"]
        },
        "style": {"type": "object"},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "additionalProperties": true
    }
  }
}
